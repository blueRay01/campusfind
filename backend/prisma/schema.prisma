generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model claims {
  id          Int       @id @default(autoincrement())
  post_id     Int?
  claimant_id Int?
  status      String?   @default("pending") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  posts       posts?    @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_posts")
  users       users?    @relation(fields: [claimant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users")
}

model posts {
  id                 Int       @id @default(autoincrement())
  user_id            Int?
  title              String    @db.VarChar(255)
  category           String    @db.VarChar(100)
  building           String    @db.VarChar(255)
  room               String?   @db.VarChar(100)
  image_url          String?   @db.VarChar(500)
  status             String    @db.VarChar(20)
  is_resolved        Boolean?  @default(false)
  handed_to_security Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  is_claimed         Boolean?  @default(false)
  pickup_location    String?   @db.VarChar(255)
  description        String?
  claims             claims[]
  users              users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users")
}

model users {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  student_id     String?   @unique @db.VarChar(100)
  email          String    @unique @db.VarChar(100)
  password       String    @db.VarChar(100)
  course         String?   @db.VarChar(100)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  messenger_link String?   @db.VarChar(255)
  claims         claims[]
  posts          posts[]
}
